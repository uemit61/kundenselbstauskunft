; Vorlage für die .env im Projektstamm.
; Nach .env kopieren und die Werte anpassen. Die .env selbst wird nie committet.
; Format: INI (wird mit parse_ini_file gelesen), Kommentare beginnen mit Semikolon.

; Datenbank (XAMPP-Standard: Benutzer root ohne Passwort)
; Bei abweichendem Port wird er an den Host angehängt, z. B. 127.0.0.1:3307
DB_HOST=localhost
DB_NAME=config_self_disclosure
DB_USER=root
DB_PASS=

; Pepper für die Passwort-Hashes: langer Zufallswert, mindestens 32 Byte.
; Erzeugen z. B. mit:  php -r "echo bin2hex(random_bytes(32));"
; Ohne Pepper bricht das Setzen eines Passworts ab, und keine Anmeldung gelingt.
; Wird der Pepper geändert, müssen alle Passwörter neu gesetzt werden.
PASSWORD_PEPPER=
